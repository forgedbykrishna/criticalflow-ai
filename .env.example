# ==============================================================================
# CriticalFlow AI - Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
#
# SECURITY NOTICE:
# - Do NOT commit real secrets, passwords, or API keys to version control.
# - The default POSTGRES_PASSWORD below is strictly for local development and demos.
# - Production deployments MUST supply a strong, unique password via a secure secret store.
# ==============================================================================

# ---- PostgreSQL Database ----
POSTGRES_DB=criticalflow
POSTGRES_USER=postgres
# DEV ONLY: Replace with a secure, strong password in production environments!
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ---- Service Host Published Ports ----
# Local host ports mapped to container ports
M3_PORT=8000
M4_PORT=8001
M5_PORT=8002
DASHBOARD_PORT=8501

# ---- M6 Streamlit Dashboard (Profile: dashboard) ----
# Leave empty to read from the local Docker PostgreSQL service automatically:
#   postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/criticalflow
# Or provide an external hosted connection string (e.g., Neon PostgreSQL):
#   DASHBOARD_DATABASE_URL=postgresql://USER:PASSWORD@HOST/criticalflow?sslmode=require
DASHBOARD_DATABASE_URL=

# SSL behavior for dashboard database connection:
# - "prefer" (default): negotiates SSL if supported (Neon), falls back to plain TCP on local Docker
# - "require": strictly requires SSL (fails on unencrypted local Docker)
# - "disable": strictly disables SSL
DB_SSLMODE=prefer

# ---- M3 Backend API Security (Optional) ----
# If set, external callers (and M2) must provide this token via Bearer or X-API-Key:
API_KEY=

# ---- M2 IBM Z Ingestion Poller (Profile: live-zosmf) ----
# Live z/OSMF credentials (leave blank if not using live-zosmf profile):
MOCK_MODE=False
ZOSMF_URL=
ZOSMF_USER=
ZOSMF_PASSWORD=
ZOSMF_VERIFY_TLS=true
CF_JOB_PREFIX=PAY*,GL*
CF_JOB_OWNER=*
CF_DEFAULT_SUBSYSTEM=PAYMENT-API
CF_DEFAULT_SYSTEM_ID=AUTO
