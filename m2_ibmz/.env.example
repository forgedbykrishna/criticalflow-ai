# ---- mode ----
MOCK_MODE=False
FALLBACK_TO_MOCK=False        # demo only; production must stay False

# ---- z/OSMF (Approach A) ----
ZOSMF_URL=https://zos.example.com:443
ZOSMF_USER=CFSVC
ZOSMF_PASSWORD=change-me      # inject from a secret manager; never commit
ZOSMF_VERIFY_TLS=/etc/ssl/certs/zos-ca.pem   # CA bundle path, or "true"; "false" only in a sandbox

# ---- what to harvest ----
CF_JOB_PREFIX=PAY*,GL*        # comma-separated job-name prefixes
CF_JOB_OWNER=*                # or the batch owner ID
CF_DEFAULT_SUBSYSTEM=PAYMENT-API
CF_DEFAULT_SYSTEM_ID=SYSA
CF_UTC_OFFSET=0               # mainframe local time offset from UTC, hours (e.g. 5.5 for IST)
CF_STATE_FILE=/var/lib/criticalflow/state.json
CF_QUARANTINE_DIR=/var/lib/criticalflow/quarantine

# ---- M3 API ----
API_BASE_URL=https://api.criticalflow.example.com
API_TOKEN=change-me
API_TIMEOUT_S=15
